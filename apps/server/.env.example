# Copy this file to .env and fill in your values
# Never commit .env to version control

NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.x1fnkvs.mongodb.net/schoolos?retryWrites=true&w=majority&appName=Cluster0
FRONTEND_URL=http://localhost:5173

# Optional: triggers real n8n webhook. When unset, P0 simulation runs.
# N8N_WEBHOOK_URL=https://your-n8n-instance.com/webhook/your-path
SCHOOL_NAME=Sunrise Academy

# JWT — generate strong random secrets for production
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-64-char-random-hex-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-char-random-hex-secret

# Rate limiting (defaults shown)
# RATE_LIMIT_WINDOW_MS=900000
# RATE_LIMIT_MAX=200

# Push notifications (Firebase Cloud Messaging) — optional. Without it, push
# sends silently no-op and only the existing in-app notification is created.
# Paste the full service-account JSON (Firebase console → Project settings →
# Service accounts → Generate new private key) as a single line.
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...",...}

# WhatsApp (Meta Cloud API) — optional. Without WHATSAPP_ACCESS_TOKEN and
# WHATSAPP_PHONE_NUMBER_ID, the whatsapp channel is treated as unconfigured
# and sends fail with a clear "not configured" error in the notification log.
# Get these from Meta Business Manager → WhatsApp → API Setup.
# WHATSAPP_ACCESS_TOKEN=your-permanent-access-token
# WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
# Arbitrary string you choose — must match what you enter in Meta's webhook
# verification screen (Meta Business Manager → WhatsApp → Configuration).
# WHATSAPP_VERIFY_TOKEN=choose-a-random-verification-string
# WHATSAPP_API_VERSION=v21.0
