{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/web"],
      "port": 5183,
      "autoPort": true
    },
    {
      "name": "server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "-w", "apps/server"],
      "port": 5050,
      "autoPort": true
    },
    {
      "name": "buddy-kit",
      "runtimeExecutable": "python",
      "runtimeArgs": ["-m", "http.server", "5190", "--directory", "docs/companion-buddy-kit"],
      "port": 5190
    },
    {
      "name": "mobile-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "web", "-w", "apps/mobile"],
      "port": 8081,
      "autoPort": true
    }
  ]
}
