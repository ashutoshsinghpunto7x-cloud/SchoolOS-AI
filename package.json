{
  "name": "schoolos-ai",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names \"SERVER,WEB\" --prefix-colors \"blue,green\" \"npm run dev -w apps/server\" \"npm run dev -w apps/web\"",
    "dev:server": "npm run dev -w apps/server",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build -w packages/types && npm run build -w packages/utils && npm run build -w apps/server && npm run build -w apps/web",
    "type-check": "tsc --noEmit -p tsconfig.base.json",
    "lint": "eslint apps packages --max-warnings=100000",
    "lint:fix": "eslint apps packages --fix",
    "test": "npm test -w apps/server",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.1.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "typescript": "^5.3.2",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "firebase": "^12.16.0"
  },
  "allowScripts": {
    "@firebase/util@1.15.1": true,
    "protobufjs@7.6.5": true,
    "esbuild@0.21.5": true,
    "esbuild@0.28.1": true,
    "lightningcss@1.33.0": true,
    "terser@5.49.0": true
  }
}
